{
  "id": "fnack.subsonic",
  "name": "Subsonic API",
  "version": "1.1.0",
  "type": ["server_extension"],
  "api_version": "^1.0",
  "min_core_version": "0.3.21",
  "entry_point": "plugin:SubsonicPlugin",
  "author": "fnack",
  "description": "Exposes fnack's library as a Subsonic/OpenSubsonic server (Symfonium/DSub/Sublime Music). XML+JSON, search3, stream/download, and optional AudioMuse-AI sonic similarity (default off). Auth via the fnack M2M API key.",
  "homepage": "",
  "permissions": ["settings", "library:read", "network"],
  "settings_schema": [
    {
      "key": "enabled",
      "type": "boolean",
      "default": "true"
    },
    {
      "key": "audiomuse_enabled",
      "type": "boolean",
      "default": "false"
    },
    {
      "key": "audiomuse_base_url",
      "type": "string",
      "default": ""
    },
    {
      "key": "audiomuse_api_key",
      "type": "secret",
      "default": ""
    }
  ],
  "ui": {
    "slots": []
  },
  "actions": [
    {
      "id": "test-audiomuse-connection",
      "label": "Test AudioMuse-AI connection"
    }
  ],
  "dependencies": {},
  "trust_level": "official",
  "capabilities": ["server.extension"]
}
